{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human Atlas",
  "version": "0.1.0",
  "identifier": "io.github.isunky.humanatlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3016",
    "beforeBuildCommand": "npm run build:client",
    "frontendDist": "../dist-client"
  },
  "app": {
    "windows": [{"label": "main", "title": "Human Atlas", "width": 1280, "height": 800, "minWidth": 960, "minHeight": 640, "center": true}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "isunky",
    "shortDescription": "Offline bilingual 3D anatomy explorer",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type": "embedBootstrapper", "silent": true},
      "nsis": {"installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true}
    }
  }
}
